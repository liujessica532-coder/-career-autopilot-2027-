# Generate a URL-safe password: python -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=
JOB_SOURCES_JSON=[]
# Local development only; compose overrides this:
DATABASE_URL=sqlite:///artifacts/local.db
# Browser operator interface: loopback only; access remotely through SSH forwarding.
HANDOVER_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Browser state key and operator token are generated in ignored private/.
